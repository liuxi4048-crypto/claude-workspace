# Anthropic API キー
# https://console.anthropic.com/ で取得してください
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Codex MCP サーバー（mcp/codex/）用の設定（任意）
# APIキーではなく `codex login`（ChatGPTアカウント認証）を使用するため、
# ここにトークンを書く必要はない。詳細は mcp/codex/README.md を参照。
# CODEX_MODEL=gpt-5-codex
# CODEX_ALLOWED_ROOTS は .mcp.json 側で既定設定済み（絶対パス推奨）
